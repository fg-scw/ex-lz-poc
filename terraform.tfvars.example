# Copy to terraform.tfvars (not committed) and adapt.

# --- On-prem links ---------------------------------------------------------------
# Department traffic (Internet and on-prem) leaves through the on-prem
# firewalls. At least one link is required. The link carrying the traffic is
# the Interlink when set, otherwise the VPN. On-prem MUST announce 0.0.0.0/0 on
# that link (Internet exit), and the on-prem firewalls must allow dept_supernet
# (10.64.0.0/10 by default).

# S2S VPN (Egress VPC): the starting point. One tunnel per zone (a: fr-par-1, b: fr-par-2).
vpn = {
  customer_gateway_ip = "198.51.100.1"
  customer_asn        = 65010
  onprem_cidrs        = ["192.168.0.0/16"]
  # zones = { a = "fr-par-1", b = "fr-par-2" }
}

# Interlink (Hybrid VPC): add it to move the department traffic off the VPN.
# interlink = {
#   pop_id         = "fr-par/<pop-uuid>"
#   bandwidth_mbps = 1000
#   partner_id     = "fr-par/<partner-uuid>"
#   onprem_cidrs   = ["10.10.0.0/16"]
# }

# --- Departments ----------------------------------------------------------------
# Single source of truth for the address plan and the network policy the DSI
# imposes on each department. Adding an entry creates its project, VPCs and
# NACLs; removing one destroys them.
#
# index (0-1023)   permanent and unique: sets the department CIDRs
#                  (Pub /22 from 10.64.0.0/12, Private /21 from 10.96.0.0/11).
#                  Never renumber a live department; keep the index of a
#                  destroyed department reserved until its project is fully gone.
# hybrid_bypass    peer the department Private VPC with the Hybrid VPC (Interlink,
#                  direct to on-prem). Needs interlink above. Costs 2 extra
#                  peering connectors.
# nacl_inbound     flows allowed INTO the department from outside it (on-prem,
#                  DSI). Another department as source has no effect: the Hub ACL
#                  drops that traffic. The department NACLs drop every other
#                  inbound connection, except to the return range (TCP/UDP
#                  32768-65535, open to all).
#                  { to: "pub"|"private", source: CIDR, protocol: ANY|TCP|UDP|ICMP,
#                    port: 0 = all, port_end: optional range end, description }
departments = {
  genomic = {
    index         = 1
    hybrid_bypass = false # true once interlink is set
    nacl_inbound = [
      {
        to          = "private"
        source      = "192.168.10.0/24" # on-prem CIDR (inside vpn.onprem_cidrs)
        port        = 8080
        description = "On-prem clients to genomic backends"
      },
    ]
  }
}
