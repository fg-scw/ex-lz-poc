# On-prem connectivity. Both links are optional, at least one is required.
# - S2S VPN (Egress VPC, one gateway per zone).
# - Interlink (Hybrid VPC). It carries the department traffic when set;
#   otherwise the VPN does. Departments with hybrid_bypass also peer their
#   Private VPC with Hybrid (department module).
# The on-prem side must announce 0.0.0.0/0 on the link that carries the
# department traffic: that is the Internet exit of the landing zone.

locals {
  vpn_gateways = var.vpn == null ? {} : {
    a = { zone = var.vpn.zones.a, bgp_scaleway = var.vpn.bgp_links.a.scaleway, bgp_onprem = var.vpn.bgp_links.a.onprem }
    b = { zone = var.vpn.zones.b, bgp_scaleway = var.vpn.bgp_links.b.scaleway, bgp_onprem = var.vpn.bgp_links.b.onprem }
  }
}

resource "scaleway_s2s_vpn_gateway" "this" {
  for_each = local.vpn_gateways

  name               = "${var.name}-vpn-${each.key}"
  project_id         = local.project_id
  gateway_type       = var.vpn.gateway_type
  private_network_id = scaleway_vpc_private_network.this["egress"].id
  zone               = each.value.zone
  tags               = var.tags
}

data "scaleway_ipam_ip" "vpn_gateway" {
  for_each   = scaleway_s2s_vpn_gateway.this
  ipam_ip_id = one(each.value.public_config[*].ipam_ipv4_id)
}

resource "scaleway_s2s_vpn_customer_gateway" "this" {
  count = var.vpn == null ? 0 : 1

  name        = "${var.name}-onprem"
  project_id  = local.project_id
  ipv4_public = var.vpn.customer_gateway_ip
  asn         = var.vpn.customer_asn
  tags        = var.tags
}

resource "scaleway_s2s_vpn_routing_policy" "this" {
  count = var.vpn == null ? 0 : 1

  name              = "${var.name}-vpn"
  project_id        = local.project_id
  is_ipv6           = false
  prefix_filter_in  = concat(["0.0.0.0/0"], var.vpn.onprem_cidrs)
  prefix_filter_out = local.interlink_is_path ? [var.cidrs.egress] : [var.dept_supernet, var.cidrs.egress]
  tags              = var.tags
}

# The PSKs are generated by Scaleway and stored in Secret Manager (see outputs).
resource "scaleway_s2s_vpn_connection" "this" {
  for_each = local.vpn_gateways

  name                     = "${var.name}-vpn-${each.key}"
  project_id               = local.project_id
  vpn_gateway_id           = scaleway_s2s_vpn_gateway.this[each.key].id
  customer_gateway_id      = scaleway_s2s_vpn_customer_gateway.this[0].id
  initiation_policy        = "customer_gateway"
  enable_route_propagation = true
  tags                     = var.tags

  bgp_config_ipv4 {
    routing_policy_id = scaleway_s2s_vpn_routing_policy.this[0].id
    private_ip        = each.value.bgp_scaleway
    peer_private_ip   = each.value.bgp_onprem
  }

  ikev2_ciphers {
    encryption = var.vpn.ciphers.ike.encryption
    integrity  = var.vpn.ciphers.ike.integrity
    dh_group   = var.vpn.ciphers.ike.dh_group
  }

  esp_ciphers {
    encryption = var.vpn.ciphers.esp.encryption
    integrity  = var.vpn.ciphers.esp.integrity
    dh_group   = var.vpn.ciphers.esp.dh_group
  }
}

resource "scaleway_interlink_routing_policy" "this" {
  count = var.interlink == null ? 0 : 1

  name              = "${var.name}-interlink"
  project_id        = local.project_id
  is_ipv6           = false
  prefix_filter_in  = concat(["0.0.0.0/0"], var.interlink.onprem_cidrs)
  prefix_filter_out = [var.dept_supernet, var.cidrs.hybrid]
  tags              = var.tags
}

resource "scaleway_interlink_link" "this" {
  count = var.interlink == null ? 0 : 1

  name                     = "${var.name}-interlink"
  project_id               = local.project_id
  pop_id                   = var.interlink.pop_id
  bandwidth_mbps           = var.interlink.bandwidth_mbps
  partner_id               = var.interlink.partner_id
  connection_id            = var.interlink.connection_id
  peer_asn                 = var.interlink.peer_asn
  vlan                     = var.interlink.vlan
  vpc_id                   = scaleway_vpc.this["hybrid"].id
  routing_policy_v4_id     = scaleway_interlink_routing_policy.this[0].id
  enable_route_propagation = true
  tags                     = var.tags
}
