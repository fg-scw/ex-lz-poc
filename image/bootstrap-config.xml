<?xml version="1.0"?>
<!--
  Golden image bootstrap: the only configuration an image ever ships with.
  Generic for every customer and free of any secret:
    - root is locked (password "*"), no SSH key, SSH disabled, console menu
      behind a login: nobody can log in before the customer's configuration
      arrives from the instance metadata (os-scw-lz, sync.sh);
    - only vtnet0 is assigned, so the first boot never stops at the interface
      assignment prompt; Private Network legs are assigned by the customer's
      configuration;
    - no certificate (the WebUI generates its own), no CARP, no HA, no API key.
-->
<opnsense>
  <theme>opnsense</theme>
  <sysctl/>
  <system>
    <serialspeed>115200</serialspeed>
    <primaryconsole>serial</primaryconsole>
    <secondaryconsole>video</secondaryconsole>
    <optimization>normal</optimization>
    <hostname>opnsense</hostname>
    <domain>internal</domain>
    <dnsallowoverride>1</dnsallowoverride>
    <timezone>Etc/UTC</timezone>
    <timeservers>0.opnsense.pool.ntp.org 1.opnsense.pool.ntp.org</timeservers>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <user>
      <name>root</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <password>*</password>
      <uid>0</uid>
    </user>
    <webgui>
      <protocol>https</protocol>
    </webgui>
    <ssh>
      <group>admins</group>
    </ssh>
    <disableconsolemenu>1</disableconsolemenu>
    <usevirtualterminal>1</usevirtualterminal>
    <disablenatreflection>yes</disablenatreflection>
    <pf_share_forward>1</pf_share_forward>
  </system>
  <interfaces>
    <wan>
      <if>vtnet0</if>
      <descr>WAN (unused public NIC)</descr>
      <enable>1</enable>
      <ipaddr>dhcp</ipaddr>
      <blockpriv>0</blockpriv>
      <blockbogons>0</blockbogons>
    </wan>
    <lo0>
      <internal_dynamic>1</internal_dynamic>
      <descr>Loopback</descr>
      <enable>1</enable>
      <if>lo0</if>
      <ipaddr>127.0.0.1</ipaddr>
      <subnet>8</subnet>
      <type>none</type>
      <virtual>1</virtual>
    </lo0>
  </interfaces>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>
  <filter/>
</opnsense>
